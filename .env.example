# WordVision example environment file.
# Copy this file to .env.local for local experiments, or configure the same
# variables in Vercel Project Settings -> Environment Variables.

# Local Vite dev/preview proxy target for /api requests.
VITE_IMAGE_API_BASE_URL=https://wordvision.vercel.app

# Image generation. The default code path uses an OpenAI-compatible custom
# provider; switch AI_IMAGE_PROVIDER to openai if using OpenAI directly.
AI_IMAGE_PROVIDER=custom
AI_IMAGE_MODEL=grok-4.2-image
AI_IMAGE_BASE_URL=https://api.vip.crond.dev
AI_IMAGE_API_KEY=
AI_IMAGE_QUALITY=low
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_RESPONSE_FORMAT=url
AI_IMAGE_OUTPUT_FORMAT=png
AI_IMAGE_STYLE=realistic
AI_IMAGE_CACHE_STRATEGY=fast-url
AI_IMAGE_FALLBACK_MODELS=
AI_IMAGE_DAILY_LIMIT=120

# Optional: Vercel Blob token for cross-device image cache.
BLOB_READ_WRITE_TOKEN=

# Text generation. Leave AI_TEXT_API_KEY empty to use local template fallback.
AI_TEXT_PROVIDER=custom
AI_TEXT_MODEL=mimo-v2.5
AI_TEXT_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
AI_TEXT_API_KEY=
AI_TEXT_RESPONSE_FORMAT=json_object

# Optional OpenAI fallback key used by both text and image helpers when the
# provider-specific key is not set.
OPENAI_API_KEY=
